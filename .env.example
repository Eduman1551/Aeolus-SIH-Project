# Copy to .env and fill in. Never commit .env.

# PostgreSQL (local or hosted, e.g. Neon / Supabase). Plan history, events and KPI logs go here.
DATABASE_URL=postgresql://user:password@localhost:5432/aeolus

# Optional. Without a key the chat uses the offline rule-based parser.
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Frontend -> backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional tuning
# SIM_SPEED=10            # scenario minutes per real minute
# STABILITY_LAMBDA=200    # penalty per changed assignment when replanning
# MANUAL_BASELINE_MIN=180 # assumed manual planning time, used for the KPI comparison

# Copy to .env and fill in. Never commit .env.

# PostgreSQL (local or hosted, e.g. Neon / Supabase). Plan history, events and KPI logs go here.
DATABASE_URL=postgresql://user:password@localhost:5432/aeolus

# Optional. Without a key (or if the model is unavailable) the chat uses the offline rule-based parser.
# Use a model id your Groq key can see, e.g. openai/gpt-oss-20b or qwen/qwen3.8-27b.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Frontend -> backend URL (on Vercel: the https URL of the deployed backend)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional. Leave empty to derive it from NEXT_PUBLIC_API_URL (https -> wss, path /ws)
NEXT_PUBLIC_WS_URL=

# Backend host only: dashboard origins allowed by CORS, comma separated (e.g. your Vercel URL)
ALLOWED_ORIGINS=
# Optional regex for extra origins, e.g. Vercel preview URLs: https://.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=

# Optional ports (pnpm dev checks they are free; CORS and the dashboard follow them)
# WEB_PORT=3000
# API_PORT=8000

# Optional tuning
# SIM_SPEED=10            # scenario minutes per real minute
# STABILITY_LAMBDA=200    # penalty per changed assignment when replanning
# MANUAL_BASELINE_MIN=180 # assumed manual planning time, used for the KPI comparison

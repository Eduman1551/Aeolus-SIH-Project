# Frontend (Vercel: Project Settings > Environment Variables). Names only, no real values.
# Locally these are read from the repo-root .env instead.

# Public URL of the FastAPI backend, e.g. the Render/Railway https URL (no trailing slash)
NEXT_PUBLIC_API_URL=

# Optional. WebSocket URL; leave empty to derive it from NEXT_PUBLIC_API_URL (https -> wss, path /ws)
NEXT_PUBLIC_WS_URL=
